
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
.env
.auth/

# Per-run Copilot CLI pipeline debug output — already uploaded as workflow
# artifacts by manual-test-pipeline.yml; never worth committing into a branch/PR.
copilot-output-*.log
otel-trace-*.jsonl
agent-output-*.log

# Generated by scripts/lib/adapters/sync-persona.js from the canonical
# .github/agents/*.agent.md personas on every Claude Code / OpenCode backend
# run — never hand-edited, never worth committing.
/.claude/agents/
/.opencode/agent/

# Per-run scratch file from scripts/lib/adapters/dispatch.sh — normally
# removed automatically when run_agent_task finishes or is interrupted; this
# is a defense-in-depth backstop, not evidence cleanup is expected to fail.
.agent-task-resolved-*.json